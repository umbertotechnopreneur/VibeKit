<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.3.0</Version>
    <AssemblyName>repo-radar</AssemblyName>
    <Product>Repo Radar</Product>
    <ApplicationIcon>../packaging/windows/RepoRadar.ico</ApplicationIcon>
    <Company>Umberto Giacobbi.biz</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <SelfContained>false</SelfContained>
    <Authors>Umberto Giacobbi</Authors>
    <Description>Track local and remote Git changes across your workspace.</Description>
    <RestorePackagesPath>../artifacts/packages</RestorePackagesPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
  </ItemGroup>
</Project>
