<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Version>1.0.44</Version>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <WindowsSdkPackageVersion>10.0.26100.87</WindowsSdkPackageVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsAppSDKDeploymentManagerInitialize>false</WindowsAppSDKDeploymentManagerInitialize>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\WaterRipple.ico</ApplicationIcon>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <Compile Include="../Shared/WidgetAbout.cs" Link="WidgetAbout.cs" />
    <Compile Include="../Shared/WindowsSignIn.cs" Link="WindowsSignIn.cs" />
    <Compile Include="../Shared/WidgetFooter.cs" Link="WidgetFooter.cs" />
    <Compile Include="../Shared/EffectStudioLayout.cs" Link="EffectStudioLayout.cs" />
    <Compile Include="../Shared/DisplayTarget.cs" Link="DisplayTarget.cs" />
    <Compile Include="../Shared/DesktopEffectStop.cs" Link="DesktopEffectStop.cs" />
    <Compile Include="../Shared/DisplayTargetPicker.cs" Link="DisplayTargetPicker.cs" />
    <Compile Include="../Shared/VibeWareDiagnostics.cs" Link="VibeWareDiagnostics.cs" />
    <Compile Include="../Shared/ProcessMemoryWatchdog.cs" Link="ProcessMemoryWatchdog.cs" />
    <Compile Include="../Shared/DiagnosticAboutActions.cs" Link="DiagnosticAboutActions.cs" />
    <EmbeddedResource Include="Shared/pipeline-catalog.json" LogicalName="WaterRipple.pipeline-catalog.json" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.6.5" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.6.5" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2526" PrivateAssets="all" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <Content Include="Assets\VibeWare.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\VibeWare-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\WaterRipple.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\WaterRipple.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="BuildNativeRenderer" BeforeTargets="CopyFilesToOutputDirectory"
          Inputs="Native\RippleRenderer.cpp;Native\RippleRenderer.h;Native\CrtFrameExport.h;..\Shared\DesktopEffectInterop.h;..\Shared\EffectWindowCoverage.h;Shaders\Ripple.hlsl;build-native.ps1"
          Outputs="$(TargetDir)RippleRenderer.dll;$(TargetDir)Shaders\RippleVS.cso;$(TargetDir)Shaders\RipplePS.cso">
    <Exec Command="powershell.exe -NoProfile -File &quot;$(MSBuildProjectDirectory)\build-native.ps1&quot; -OutputDirectory &quot;$(TargetDir).&quot; -IntermediateDirectory &quot;$(IntermediateOutputPath)Native&quot; -Configuration &quot;$(Configuration)&quot;" />
  </Target>
</Project>
