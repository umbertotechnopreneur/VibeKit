<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <WindowsSdkPackageVersion>10.0.26100.87</WindowsSdkPackageVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsAppSDKDeploymentManagerInitialize>false</WindowsAppSDKDeploymentManagerInitialize>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Version>0.1.3</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Vignette.ico</ApplicationIcon>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <!-- The notification area icon needs WinForms without the WindowsDesktop XAML build targets. -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.6.5" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.6.5" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2526" PrivateAssets="all" />
    <Using Include="System" />
    <Compile Include="../../Shared/DisplayTarget.cs" Link="DisplayTarget.cs" />
    <Compile Include="../../Shared/EffectStudioLayout.cs" Link="EffectStudioLayout.cs" />
    <Compile Include="../../Shared/WidgetAbout.cs" Link="WidgetAbout.cs" />
    <Compile Include="../../Shared/WidgetFooter.cs" Link="WidgetFooter.cs" />
    <Compile Include="../../Shared/WindowsSignIn.cs" Link="WindowsSignIn.cs" />
    <Compile Include="../../RetroTerminal/Windows/Studio/ScrollBarBehavior.cs" Link="ScrollBarBehavior.cs" />
    <EmbeddedResource Include="../Shared/pipelines.json" LogicalName="Vignette.Pipelines" />
    <Content Include="Vignette.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../RetroTerminal/Linux/extension/retro-terminal@vibeware.local/VibeWare.png" Link="Assets/VibeWare.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../RetroTerminal/Linux/extension/retro-terminal@vibeware.local/VibeWare-LICENSE.txt" Link="Assets/VibeWare-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../LICENSE" Link="LICENSE.txt" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
