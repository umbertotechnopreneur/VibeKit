<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <SelfContained>false</SelfContained>
    <Version>1.0.17</Version>
    <ApplicationIcon>RetroTerminal.ico</ApplicationIcon>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows10.0.26100.0</TargetFramework><TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion><WindowsSdkPackageVersion>10.0.26100.87</WindowsSdkPackageVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest><UseWinUI>true</UseWinUI><WindowsPackageType>None</WindowsPackageType><WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained><WindowsAppSDKDeploymentManagerInitialize>false</WindowsAppSDKDeploymentManagerInitialize>
    <PlatformTarget Condition="'$(Platform)' == 'ARM64' or '$(RuntimeIdentifier)' == 'win-arm64'">arm64</PlatformTarget>
    <PlatformTarget Condition="'$(PlatformTarget)' == ''">x64</PlatformTarget><Platforms>x64;ARM64</Platforms><RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$(PlatformTarget)</RuntimeIdentifier><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.6.5" /><PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.6.5" /><PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2526" PrivateAssets="all" /></ItemGroup>
  <ItemGroup>
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <Compile Include="../../../Shared/VibeWareDiagnostics.cs" Link="VibeWareDiagnostics.cs" />
    <Compile Include="../../../Shared/ProcessMemoryWatchdog.cs" Link="ProcessMemoryWatchdog.cs" />
    <Compile Include="../../../Shared/DiagnosticAboutActions.cs" Link="DiagnosticAboutActions.cs" />
    <Compile Include="../../../Shared/WidgetFooter.cs" Link="WidgetFooter.cs" />
    <Compile Include="../../../Shared/EffectStudioLayout.cs" Link="EffectStudioLayout.cs" />
    <Compile Include="../../../Shared/DisplayTarget.cs" Link="DisplayTarget.cs" />
    <Compile Include="../../../Shared/DisplayTargetPicker.cs" Link="DisplayTargetPicker.cs" />
    <Compile Include="../../../Shared/WindowsSignIn.cs" Link="WindowsSignIn.cs" />
  </ItemGroup>
  <ItemGroup><Content Include="../../Linux/extension/retro-terminal@vibeware.local/VibeWare.png" Link="Assets/VibeWare.png" CopyToOutputDirectory="PreserveNewest" /><Content Include="../../Linux/extension/retro-terminal@vibeware.local/VibeWare-LICENSE.txt" Link="Assets/VibeWare-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
</Project>
