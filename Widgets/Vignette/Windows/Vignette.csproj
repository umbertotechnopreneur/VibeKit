<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <SelfContained>false</SelfContained>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget Condition="'$(RuntimeIdentifier)' == 'win-arm64'">ARM64</PlatformTarget>
    <PlatformTarget Condition="'$(RuntimeIdentifier)' != 'win-arm64'">x64</PlatformTarget>
    <Version>0.1.1</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- WPF and the desktop overlay use the same per-monitor DPI manifest. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Vignette.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Shared/DisplayTarget.cs" Link="DisplayTarget.cs" />
    <Compile Include="../../Shared/WindowsSignIn.cs" Link="WindowsSignIn.cs" />
    <EmbeddedResource Include="../Shared/pipelines.json" LogicalName="Vignette.Pipelines" />
    <Content Include="Vignette.ico" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../RetroTerminal/Linux/extension/retro-terminal@vibeware.local/VibeWare.png" Link="VibeWare.png" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../RetroTerminal/Linux/extension/retro-terminal@vibeware.local/VibeWare-LICENSE.txt" Link="VibeWare-LICENSE.txt" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../LICENSE" Link="LICENSE.txt" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
