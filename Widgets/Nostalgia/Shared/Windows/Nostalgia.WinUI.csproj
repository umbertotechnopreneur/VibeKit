<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <WindowsSdkPackageVersion>10.0.26100.87</WindowsSdkPackageVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Nostalgia.WinUI</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.6.5" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2526" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinUIAnalyzer" Version="0.8.0" PrivateAssets="all" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <Compile Include="../../../Shared/WidgetAbout.cs;../../../Shared/WidgetTrayMenu.cs;../../../Shared/WidgetTrayIcon.cs;../../../Shared/DesktopEffectStop.cs;../../../Shared/DiagnosticAboutActions.cs;../../../Shared/VibeWareDiagnostics.cs" Link="%(Filename)%(Extension)" />
    <Content Include="../Assets/VibeWare.png;../Assets/VibeWare-LICENSE.txt" Link="Assets/%(Filename)%(Extension)" />
    <None Include="../Assets/VibeWare.png;../Assets/VibeWare-LICENSE.txt" TargetPath="Nostalgia.WinUI/Assets/%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    <!-- Ripple's built-in log checks request a temporary diagnostics store. -->
    <InternalsVisibleTo Include="WaterRipple" />
  </ItemGroup>
</Project>
