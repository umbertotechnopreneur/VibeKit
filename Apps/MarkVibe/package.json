{
  "name": "markvibe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "check": "pwsh -NoProfile -File scripts/check.ps1",
    "bundle": "node scripts/bundle.mjs",
    "bundle:debug": "node scripts/bundle.mjs --debug",
    "test:client": "node --test tests/client/path.test.mjs tests/client/rendering.test.mjs tests/client/workspaces.test.mjs",
    "test:windows": "pwsh -NoProfile -File tests/windows/smoke.ps1",
    "test:reader-surface": "node tests/client/reader-surface.mjs",
    "test:svg": "node tests/client/svg.mjs"
  },
  "dependencies": {
    "dompurify": "3.4.16",
    "highlight.js": "11.12.0",
    "mermaid": "12.1.0",
    "monaco-editor": "0.57.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.62.1"
  }
}
