<Window
    x:Class="MarkVibe.Reader.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="MarkVibe Reader Prototype">
    <Grid x:Name="Shell" RowDefinitions="Auto,*" ColumnDefinitions="270,*" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Border Grid.ColumnSpan="2" Padding="16,10" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Button x:Name="OpenButton" Content="Open folder…" Click="OpenFolder" />
                <TextBlock x:Name="Status" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />
            </Grid>
        </Border>
        <Border Grid.Row="1" BorderThickness="0,0,1,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <ListView x:Name="Documents" SelectionChanged="SelectDocument" AutomationProperties.Name="Markdown files">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Path}" TextWrapping="WrapWholeWords" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
        <Grid x:Name="ReaderPane" Grid.Row="1" Grid.Column="1">
            <TextBlock x:Name="Placeholder" Text="Open a folder to read its Markdown files." HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
