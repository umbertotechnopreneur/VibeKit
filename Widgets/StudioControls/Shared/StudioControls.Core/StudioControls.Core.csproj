<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Windows publish passes its RID to project references. Keep both the
         generic test target and the Windows restore target in the same lock. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>VibeKit.StudioControls.Core</RootNamespace>
    <AssemblyName>StudioControls.Core</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../scene-catalog.json" LogicalName="StudioControls.Catalog.json" />
  </ItemGroup>
</Project>
