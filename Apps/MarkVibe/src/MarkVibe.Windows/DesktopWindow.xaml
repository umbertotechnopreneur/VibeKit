<Window
    x:Class="MarkVibe.Windows.DesktopWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="MarkVibe">
    <Grid x:Name="Shell" Background="{ThemeResource WorkspaceGlassOverlayBrush}"
          RowDefinitions="Auto,*,Auto" Loaded="ShellLoaded" SizeChanged="ShellSizeChanged">
        <Border Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}" IsHitTestVisible="False" />
        <Grid x:Name="ToolbarLayout" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto"
              Padding="8,0" ColumnSpacing="8" Background="{ThemeResource WorkspaceToolbarTintBrush}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="SidebarToggle" Style="{StaticResource SubtleButtonStyle}" Click="ToggleSidebar" Visibility="Collapsed"
                        AutomationProperties.Name="Toggle document sidebar" ToolTipService.ToolTip="Toggle sidebar">
                    <SymbolIcon Symbol="GlobalNavigationButton" />
                </Button>
                <Button x:Name="BackButton" Style="{StaticResource SubtleButtonStyle}" Click="Back" IsEnabled="False"
                        AutomationProperties.Name="Back" ToolTipService.ToolTip="Back">
                    <SymbolIcon Symbol="Back" />
                </Button>
                <Button x:Name="ForwardButton" Style="{StaticResource SubtleButtonStyle}" Click="Forward" IsEnabled="False"
                        AutomationProperties.Name="Forward" ToolTipService.ToolTip="Forward">
                    <SymbolIcon Symbol="Forward" />
                </Button>
            </StackPanel>
            <SelectorBar x:Name="DocumentToolbar" Grid.Column="1" HorizontalAlignment="Left"
                         VerticalAlignment="Center" SelectionChanged="SelectView">
                <SelectorBarItem x:Name="ReadButton" Text="Read" Tag="read" />
                <SelectorBarItem x:Name="SourceButton" Text="Source" Tag="source" />
                <SelectorBarItem x:Name="SplitButton" Text="Split" Tag="split" />
                <SelectorBarItem x:Name="MapButton" Text="Map" Tag="map" />
            </SelectorBar>
            <CommandBar x:Name="Header" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                        DefaultLabelPosition="Right" OverflowButtonVisibility="Auto" Background="Transparent">
                <AppBarButton x:Name="OpenFileButton" Label="Open file" Icon="OpenFile" Click="OpenFile" />
                <AppBarButton x:Name="OpenFolderButton" Label="Open folder" Icon="Folder" Click="OpenFolder" />
                <AppBarButton x:Name="FindButton" Label="Find" Icon="Find" Click="OpenFind" LabelPosition="Collapsed" />
                <AppBarButton x:Name="SettingsButton" Label="Settings" Icon="Setting" Click="ShowSettings" LabelPosition="Collapsed" />
                <AppBarButton x:Name="ShellMenuButton" Label="More commands" Icon="More" LabelPosition="Collapsed">
                    <AppBarButton.Flyout>
                        <MenuFlyout x:Name="ShellMenu" Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem x:Name="RecentButton" Text="Recent" Click="ShowRecent" />
                            <MenuFlyoutItem x:Name="ExportButton" Text="Export" Click="ShowExport" />
                            <MenuFlyoutItem x:Name="AiButton" Text="Open assistant" Click="ToggleAi" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="AboutButton" Text="About MarkVibe" Click="ShowAbout" />
                        </MenuFlyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
            </CommandBar>
        </Grid>
        <Grid x:Name="WorkArea" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="0" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="AiColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <Border x:Name="Sidebar" Background="Transparent" Visibility="Collapsed">
                <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="10" RowSpacing="8">
                    <StackPanel>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                            <TextBlock x:Name="WorkspaceName" Margin="2,0" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <Button x:Name="FolderCommandsButton" Grid.Column="1" Style="{StaticResource SubtleButtonStyle}"
                                    Width="32" Height="32" Padding="4" AutomationProperties.Name="Folder commands" IsEnabled="False">
                                <FontIcon Glyph="&#xE712;" FontSize="14" />
                                <Button.Flyout>
                                    <MenuFlyout x:Name="FolderCommandsMenu" Placement="BottomEdgeAlignedRight">
                                        <MenuFlyoutItem x:Name="GoUpFolderMenuItem" Text="Go up one folder" Click="OpenParent" />
                                        <MenuFlyoutItem x:Name="RefreshFolderMenuItem" Text="Refresh folder" Click="RefreshWorkspace" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                        <TextBlock x:Name="WorkspaceNamesWarning" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                    <SelectorBar x:Name="SidebarTabs" Grid.Row="1" HorizontalAlignment="Left"
                                 SelectionChanged="SelectNavigationMode">
                        <SelectorBarItem x:Name="PagesButton" Text="Pages" Tag="pages" IsSelected="True" />
                        <SelectorBarItem x:Name="OutlineButton" Text="Outline" Tag="outline" />
                    </SelectorBar>
                    <StackPanel x:Name="PagesSearchPanel" Grid.Row="2" Spacing="4">
                        <Grid>
                            <TextBox x:Name="PagesSearchBox" IsEnabled="False" TextChanged="PagesSearchChanged"
                                     GotFocus="PagesSearchFocusChanged" LostFocus="PagesSearchFocusChanged"
                                     AutomationProperties.AutomationId="PagesSearchBox" AutomationProperties.Name="Search document contents" />
                            <FontIcon x:Name="PagesSearchWatermark" Glyph="&#xE721;" FontSize="14" Margin="12,0"
                                      HorizontalAlignment="Left" VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsHitTestVisible="False"
                                      AutomationProperties.AccessibilityView="Raw" />
                        </Grid>
                        <ProgressBar x:Name="PagesSearchProgress" Visibility="Collapsed"
                                     AutomationProperties.AutomationId="PagesSearchProgress" AutomationProperties.Name="Search progress" />
                        <TextBlock x:Name="PagesSearchStatus" Visibility="Collapsed" TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="PagesSearchStatus" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                    <StackPanel x:Name="OutlineFindPanel" Grid.Row="2" Visibility="Collapsed" Spacing="4">
                        <TextBox x:Name="OutlineFindQuery" PlaceholderText="Find in document" MaxLength="256"
                                 TextChanged="OutlineFindQueryChanged" KeyDown="FindKeyDown" />
                        <Grid x:Name="OutlineFindActions" Visibility="Collapsed" ColumnDefinitions="*,Auto,Auto">
                            <TextBlock x:Name="OutlineFindCount" VerticalAlignment="Center" Margin="4,0"
                                       AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" />
                            <Button x:Name="OutlinePrevious" Grid.Column="1" Click="FindPrevious" Style="{StaticResource SubtleButtonStyle}">
                                <FontIcon Glyph="&#xE70E;" FontSize="14" />
                            </Button>
                            <Button x:Name="OutlineNext" Grid.Column="2" Click="FindNext" Style="{StaticResource SubtleButtonStyle}">
                                <FontIcon Glyph="&#xE70D;" FontSize="14" />
                            </Button>
                        </Grid>
                    </StackPanel>
                    <ListView x:Name="OutlineFindResults" Grid.Row="3" Visibility="Collapsed"
                              SelectionChanged="OutlineMatchSelected" IsItemClickEnabled="True" ItemClick="OutlineMatchClicked"
                              HorizontalContentAlignment="Stretch"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                    <TreeView x:Name="NavigationTree" Grid.Row="3" ItemInvoked="ActivateTreeItem"
                              ContextRequested="TreeContextRequested" SelectionMode="Single"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Workspace documents">
                        <TreeView.ItemTemplate>
                            <DataTemplate x:DataType="TreeViewNode">
                                <ContentPresenter Content="{x:Bind Content}" HorizontalContentAlignment="Stretch"
                                                  Loaded="NavigationPresenterLoaded" DataContextChanged="NavigationPresenterContextChanged" />
                            </DataTemplate>
                        </TreeView.ItemTemplate>
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                </Grid>
            </Border>
            <Grid x:Name="DocumentArea" Grid.Column="1" RowDefinitions="Auto,*">
                <Border x:Name="FindBar" Grid.Row="0" Padding="8" Visibility="Collapsed" Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                        <TextBox x:Name="FindQuery" PlaceholderText="Find in document" TextChanged="FindQueryChanged" KeyDown="FindKeyDown" AutomationProperties.Name="Find in document" />
                        <TextBlock x:Name="FindCount" Grid.Column="1" VerticalAlignment="Center" />
                        <Button x:Name="FindPreviousButton" Grid.Column="2" Content="↑" Click="FindPrevious" AutomationProperties.Name="Previous match" />
                        <Button x:Name="FindNextButton" Grid.Column="3" Content="↓" Click="FindNext" AutomationProperties.Name="Next match" />
                        <Button x:Name="FindCloseButton" Grid.Column="4" Content="×" Click="CloseFind" AutomationProperties.Name="Close find" />
                    </Grid>
                </Border>
                <Grid x:Name="Viewport" Grid.Row="1">
                    <Grid x:Name="ReaderSlot" />
                    <Grid x:Name="SplitChrome" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="SplitSourceColumn" Width="1*" />
                            <ColumnDefinition x:Name="SplitReaderColumn" Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Thumb x:Name="SplitGrip" Grid.Column="1" Style="{StaticResource PaneResizeGripStyle}" HorizontalAlignment="Left" Margin="-3,0,0,0"
                               DragDelta="DragSplit" DragCompleted="FinishSplitDrag"
                               KeyDown="ResizePaneByKey" AutomationProperties.Name="Resize source and reader" />
                    </Grid>
                    <Grid x:Name="MapSlot" Visibility="Collapsed" />
                    <ScrollViewer x:Name="Welcome" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch"
                                  VerticalContentAlignment="Stretch" IsTabStop="False">
                        <Grid Padding="20,24">
                            <StackPanel MaxWidth="360" VerticalAlignment="Center" Spacing="20">
                                <StackPanel Spacing="4">
                                    <Image Width="112" Height="112" AutomationProperties.AccessibilityView="Raw"
                                           IsHitTestVisible="False">
                                        <Image.Source>
                                            <SvgImageSource UriSource="ms-appx:///app/favicon.svg" />
                                        </Image.Source>
                                    </Image>
                                    <TextBlock x:Name="WelcomeTitle" Text="Your Markdown workspace"
                                               Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap"
                                               TextAlignment="Center" AutomationProperties.HeadingLevel="Level1" />
                                </StackPanel>
                                <StackPanel Spacing="8">
                                    <Button x:Name="WelcomeOpenFile" Click="OpenFile" Style="{StaticResource AccentButtonStyle}"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                            Padding="16,12" AutomationProperties.AutomationId="WelcomeOpenFile">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                            <SymbolIcon Symbol="OpenFile" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock x:Name="WelcomeFileLabel" Text="Open file" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text=".md, .markdown, .mdown" FontSize="12" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" />
                                        </Grid>
                                    </Button>
                                    <Button x:Name="WelcomeOpenFolder" Click="OpenFolder"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                            Padding="16,12" AutomationProperties.AutomationId="WelcomeOpenFolder">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                            <SymbolIcon Symbol="Folder" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock x:Name="WelcomeFolderLabel" Text="Browse folder" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock x:Name="WelcomeFolderDetail" Text="Explore documents and subfolders"
                                                           Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" />
                                        </Grid>
                                    </Button>
                                </StackPanel>
                                <HyperlinkButton x:Name="ResumeButton" Content="Reopen last workspace" Click="ResumeWorkspace"
                                                 HorizontalAlignment="Center" Visibility="Collapsed" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                    <Border x:Name="PreviewOverlay" Visibility="Collapsed" Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}" BorderThickness="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                        <Grid RowDefinitions="Auto,*">
                            <CommandBar DefaultLabelPosition="Right">
                                <CommandBar.Content>
                                    <TextBlock x:Name="PreviewTitle" Margin="12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </CommandBar.Content>
                                <AppBarButton x:Name="PreviewBackButton" Label="Back" Icon="Back" Click="PreviewBack" />
                                <AppBarButton x:Name="PreviewOpenButton" Label="Open document" Icon="OpenFile" Click="OpenPreviewDocument" />
                                <AppBarButton x:Name="PreviewCloseButton" Label="Close" Icon="Cancel" Click="ClosePreview" />
                            </CommandBar>
                            <Grid x:Name="PreviewSlot" Grid.Row="1" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
            <Grid x:Name="AiSlot" Grid.Column="2" Visibility="Collapsed" />
            <Thumb x:Name="SidebarGrip" Grid.Column="0" Style="{StaticResource PaneResizeGripStyle}" HorizontalAlignment="Right" Margin="0,0,-3,0" Visibility="Collapsed"
                   DragDelta="DragSidebar" DragCompleted="FinishSidebarDrag" KeyDown="ResizePaneByKey" AutomationProperties.Name="Resize sidebar" />
            <Thumb x:Name="AiGrip" Grid.Column="2" Style="{StaticResource PaneResizeGripStyle}" HorizontalAlignment="Left" Margin="-3,0,0,0"
                   DragDelta="DragAi" DragCompleted="FinishAiDrag" KeyDown="ResizePaneByKey" AutomationProperties.Name="Resize assistant" />
        </Grid>
        <Grid x:Name="StatusBar" Grid.Row="2" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="12,3"
              Background="Transparent">
            <TextBlock x:Name="Status" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />
            <Grid x:Name="FooterSlot" Grid.Column="1" />
        </Grid>
    </Grid>
</Window>
