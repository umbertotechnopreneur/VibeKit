<Window
    x:Class="MarkVibe.Map.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MarkVibe.Map.WinUI"
    Title="WIN2D — MarkVibe graph · WinUI 3">
    <Grid x:Name="Root" RequestedTheme="Dark" Background="#090E16" Loaded="OnLoaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="12" Padding="12,8" Background="#102744">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="#70E5FF" CornerRadius="5" Padding="10,2">
                <TextBlock Text="WIN2D" Foreground="#091424" FontSize="22" FontWeight="Bold" />
            </Border>
            <Button x:Name="OpenButton" Grid.Column="1" Content="Open folder" Click="OpenFolder" />
            <Button x:Name="FitButton" Grid.Column="2" Content="Fit" IsEnabled="False" Click="FitGraph" />
            <TextBlock x:Name="Status" Grid.Column="3" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"
                       Text="Choose a folder containing Markdown files." />
        </Grid>
        <local:GraphCanvas x:Name="Surface" Grid.Row="1" />
    </Grid>
</Window>
