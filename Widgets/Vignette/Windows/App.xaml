<Application
    x:Class="VibeWare.Vignette.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="StudioBackgroundBrush" Color="#19191F" />
                    <SolidColorBrush x:Key="StudioChromeBrush" Color="#202027" />
                    <SolidColorBrush x:Key="StudioCardBrush" Color="#24242B" />
                    <SolidColorBrush x:Key="StudioStrokeBrush" Color="#414149" />
                    <SolidColorBrush x:Key="StudioHeadingBrush" Color="#D8C9F1" />
                    <SolidColorBrush x:Key="StudioActiveBrush" Color="#66D98A" />
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#BFA3F3" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#A68BD8" />
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#9279BE" />
                    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#D8C9F1" />
                    <SolidColorBrush x:Key="StudioSelectedBrush" Color="#383147" />
                    <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                    <StaticResource x:Key="TopNavigationViewItemBackgroundSelected" ResourceKey="StudioSelectedBrush" />
                    <StaticResource x:Key="TopNavigationViewItemBackgroundSelectedPointerOver" ResourceKey="StudioSelectedBrush" />
                    <StaticResource x:Key="NavigationViewSelectionIndicatorForeground" ResourceKey="AccentFillColorDefaultBrush" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="StudioBackgroundBrush" Color="#F4F3F7" />
                    <SolidColorBrush x:Key="StudioChromeBrush" Color="#EBE9F0" />
                    <SolidColorBrush x:Key="StudioCardBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="StudioStrokeBrush" Color="#D7D3DF" />
                    <SolidColorBrush x:Key="StudioHeadingBrush" Color="#64488B" />
                    <SolidColorBrush x:Key="StudioActiveBrush" Color="#237C45" />
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#7657A6" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#8367B0" />
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#947BBE" />
                    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#64488B" />
                    <SolidColorBrush x:Key="StudioSelectedBrush" Color="#E5DCF1" />
                    <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                    <StaticResource x:Key="TopNavigationViewItemBackgroundSelected" ResourceKey="StudioSelectedBrush" />
                    <StaticResource x:Key="TopNavigationViewItemBackgroundSelectedPointerOver" ResourceKey="StudioSelectedBrush" />
                    <StaticResource x:Key="NavigationViewSelectionIndicatorForeground" ResourceKey="AccentFillColorDefaultBrush" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="StudioBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="StudioChromeBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="StudioCardBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="StudioStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="StudioHeadingBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="StudioActiveBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{ThemeResource SystemColorHotlightColor}" />
                    <SolidColorBrush x:Key="StudioSelectedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                    <StaticResource x:Key="TopNavigationViewItemBackgroundSelected" ResourceKey="StudioSelectedBrush" />
                    <StaticResource x:Key="TopNavigationViewItemBackgroundSelectedPointerOver" ResourceKey="StudioSelectedBrush" />
                    <StaticResource x:Key="NavigationViewSelectionIndicatorForeground" ResourceKey="AccentFillColorDefaultBrush" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <Style x:Key="StudioChromeStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource StudioChromeBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource StudioStrokeBrush}" />
            </Style>
            <Style x:Key="StudioRowGroupStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource StudioCardBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource StudioStrokeBrush}" />
            </Style>
            <Style x:Key="StudioSectionHeadingStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource StudioHeadingBrush}" />
            </Style>
            <Style x:Key="StudioActiveStatusStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource StudioActiveBrush}" />
            </Style>
            <Style x:Key="StudioNavigationStyle" TargetType="NavigationView">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <Style x:Key="StudioBrandStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Foreground" Value="{ThemeResource StudioHeadingBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="SecondaryTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="WindowSurfaceStyle" TargetType="Grid">
                <Setter Property="Background" Value="{ThemeResource StudioBackgroundBrush}" />
            </Style>
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            </Style>
            <Style x:Key="DividerStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource StudioStrokeBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
