<Project>
  <!-- Renderer inputs live outside the project tree. Always enter MSBuild so its
       fingerprint can stage current assets; design-time builds remain inert. -->
  <PropertyGroup Condition="'$(BuildingInsideVisualStudio)' == 'true' and '$(MSBuildProjectName)' == 'MarkVibe.Windows'">
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
  </PropertyGroup>
</Project>
