[Desktop Entry]
Type=Application
Name=Vignette
GenericName=Desktop effects
Comment=Shade or brighten the outer edges of selected displays
Exec=sh -c "gnome-extensions enable vignette@vibeware.local && exec gnome-extensions prefs vignette@vibeware.local"
TryExec=gnome-extensions
Icon=weather-clear-night-symbolic
Terminal=false
StartupNotify=false
Categories=Settings;DesktopSettings;
Keywords=Vignette;CRT;Gradient;Screen;Effects;
