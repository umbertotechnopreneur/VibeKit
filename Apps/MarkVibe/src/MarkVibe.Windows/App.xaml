<Application x:Class="MarkVibe.Windows.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
    <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
   </ResourceDictionary.MergedDictionaries>
   <Style x:Key="CommandMenuIconStyle" TargetType="FontIcon">
    <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
   </Style>
   <Style x:Key="MapPanelStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorSecondaryBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
   </Style>
   <Style x:Key="AcrylicMapPanelStyle" TargetType="Border" BasedOn="{StaticResource MapPanelStyle}">
    <Setter Property="Background" Value="{ThemeResource AcrylicInAppFillColorDefaultBrush}" />
   </Style>
   <Style x:Key="MapInspectorStyle" TargetType="ScrollViewer">
    <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorSecondaryBrush}" />
   </Style>
   <Style x:Key="AcrylicMapInspectorStyle" TargetType="ScrollViewer">
    <Setter Property="Background" Value="{ThemeResource AcrylicInAppFillColorDefaultBrush}" />
   </Style>
   <!-- The transparent hit surface spans the pane boundary. Only interaction paints a rule. -->
   <Style x:Key="PaneResizeGripStyle" TargetType="Thumb">
    <Setter Property="Width" Value="6" />
    <Setter Property="IsTabStop" Value="True" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
    <Setter Property="FocusVisualPrimaryThickness" Value="2,0,0,0" />
    <Setter Property="FocusVisualSecondaryThickness" Value="0" />
    <Setter Property="FocusVisualMargin" Value="-2,0" />
    <Setter Property="Template">
     <Setter.Value>
      <ControlTemplate TargetType="Thumb">
       <Grid Background="Transparent">
        <VisualStateManager.VisualStateGroups>
         <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal" />
          <VisualState x:Name="PointerOver">
           <VisualState.Setters>
            <Setter Target="Indicator.Opacity" Value="1" />
           </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Pressed">
           <VisualState.Setters>
            <Setter Target="Indicator.Opacity" Value="1" />
            <Setter Target="Indicator.Width" Value="2" />
           </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Disabled" />
         </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Border x:Name="Indicator" Width="1" HorizontalAlignment="Center" Opacity="0"
                Background="{ThemeResource AccentFillColorDefaultBrush}" IsHitTestVisible="False" />
       </Grid>
      </ControlTemplate>
     </Setter.Value>
    </Setter>
   </Style>
  </ResourceDictionary>
 </Application.Resources>
</Application>
