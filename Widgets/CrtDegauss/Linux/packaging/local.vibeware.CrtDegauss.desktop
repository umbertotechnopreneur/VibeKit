[Desktop Entry]
Type=Application
Name=CRT Degauss
GenericName=Desktop effect
Comment=Simulate gradual CRT magnetization
Exec=sh -c "gnome-extensions enable crt-degauss@vibeware.local && exec gnome-extensions prefs crt-degauss@vibeware.local"
TryExec=gnome-extensions
Icon=video-display
Terminal=false
StartupNotify=false
Categories=Settings;DesktopSettings;
Keywords=CRT;Degauss;Retro;Magnetization;
OnlyShowIn=GNOME;
