<Window
    x:Class="MarkVibe.Windows.DesktopWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="MarkVibe">
    <Grid x:Name="Shell" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
          RowDefinitions="Auto,*,Auto" Loaded="ShellLoaded" SizeChanged="ShellSizeChanged">
        <CommandBar x:Name="Header" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True">
            <CommandBar.Content>
                <StackPanel Orientation="Horizontal" Spacing="4" Margin="10,0" VerticalAlignment="Center">
                    <Button x:Name="SidebarToggle" Click="ToggleSidebar" AutomationProperties.Name="Toggle document sidebar" ToolTipService.ToolTip="Toggle sidebar">
                        <SymbolIcon Symbol="GlobalNavigationButton" />
                    </Button>
                    <Button x:Name="BackButton" Click="Back" IsEnabled="False" AutomationProperties.Name="Back" ToolTipService.ToolTip="Back">
                        <SymbolIcon Symbol="Back" />
                    </Button>
                    <Button x:Name="ForwardButton" Click="Forward" IsEnabled="False" AutomationProperties.Name="Forward" ToolTipService.ToolTip="Forward">
                        <SymbolIcon Symbol="Forward" />
                    </Button>
                    <TextBlock Text="MarkVibe" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="10,0,4,0" VerticalAlignment="Center" />
                </StackPanel>
            </CommandBar.Content>
            <AppBarButton x:Name="OpenFileButton" Label="Open file" Icon="OpenFile" Click="OpenFile" />
            <AppBarButton x:Name="OpenFolderButton" Label="Open folder" Icon="Folder" Click="OpenFolder" />
            <AppBarButton x:Name="RecentButton" Label="Recent" Icon="Clock" Click="ShowRecent" />
            <AppBarButton x:Name="SettingsButton" Label="Settings" Icon="Setting" Click="ShowSettings" />
            <AppBarButton x:Name="AboutButton" Label="About" Icon="Help" Click="ShowAbout" />
        </CommandBar>
        <Grid x:Name="WorkArea" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="240" />
                <ColumnDefinition x:Name="SidebarGripColumn" Width="6" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="AiGripColumn" Width="0" />
                <ColumnDefinition x:Name="AiColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <Border x:Name="Sidebar" Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid RowDefinitions="Auto,Auto,*" Padding="10" RowSpacing="8">
                    <StackPanel>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="4">
                            <Button x:Name="ParentButton" Content="../" Click="OpenParent" AutomationProperties.Name="Go up one folder" IsEnabled="False" />
                            <TextBlock x:Name="WorkspaceName" Grid.Column="1" Text="No workspace" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <Button x:Name="RefreshButton" Grid.Column="2" Click="RefreshWorkspace" AutomationProperties.Name="Refresh folder" IsEnabled="False">
                                <SymbolIcon Symbol="Refresh" />
                            </Button>
                        </Grid>
                        <TextBlock x:Name="WorkspaceNamesWarning" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6">
                        <ToggleButton x:Name="PagesButton" Content="Pages" IsChecked="True" Click="ShowPages" />
                        <ToggleButton x:Name="OutlineButton" Content="Outline" Click="ShowOutline" />
                    </StackPanel>
                    <TreeView x:Name="NavigationTree" Grid.Row="2" ItemInvoked="ActivateTreeItem"
                              ContextRequested="TreeContextRequested" SelectionMode="Single"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Workspace documents">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                </Grid>
            </Border>
            <Thumb x:Name="SidebarGrip" Grid.Column="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" DragDelta="DragSidebar" DragCompleted="FinishSidebarDrag" AutomationProperties.Name="Resize sidebar" />
            <Grid x:Name="DocumentArea" Grid.Column="2" RowDefinitions="Auto,Auto,*">
                <CommandBar x:Name="DocumentToolbar" DefaultLabelPosition="Right">
                    <CommandBar.Content>
                        <TextBlock x:Name="DocumentTitle" Text="MarkVibe" VerticalAlignment="Center" Margin="12,0" MaxWidth="420" TextTrimming="CharacterEllipsis" />
                    </CommandBar.Content>
                    <AppBarToggleButton x:Name="ReadButton" Label="Read" Icon="Read" Tag="read" Click="SelectView" IsChecked="True" />
                    <AppBarToggleButton x:Name="SourceButton" Label="Source" Icon="Page" Tag="source" Click="SelectView" />
                    <AppBarToggleButton x:Name="SplitButton" Label="Split" Icon="ViewAll" Tag="split" Click="SelectView" />
                    <AppBarToggleButton x:Name="MapButton" Label="Map" Icon="Map" Tag="map" Click="SelectView" />
                    <AppBarSeparator />
                    <AppBarButton x:Name="FindButton" Label="Find" Icon="Find" Click="OpenFind" />
                    <AppBarButton x:Name="ExportButton" Label="Export" Icon="Save" Click="ShowExport" />
                    <AppBarToggleButton x:Name="AiButton" Label="AI" Icon="Comment" Click="ToggleAi" />
                </CommandBar>
                <Border x:Name="FindBar" Grid.Row="1" Padding="8" Visibility="Collapsed" Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                        <TextBox x:Name="FindQuery" PlaceholderText="Find in document" TextChanged="FindQueryChanged" KeyDown="FindKeyDown" AutomationProperties.Name="Find in document" />
                        <TextBlock x:Name="FindCount" Grid.Column="1" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Content="↑" Click="FindPrevious" AutomationProperties.Name="Previous match" />
                        <Button Grid.Column="3" Content="↓" Click="FindNext" AutomationProperties.Name="Next match" />
                        <Button Grid.Column="4" Content="×" Click="CloseFind" AutomationProperties.Name="Close find" />
                    </Grid>
                </Border>
                <Grid x:Name="Viewport" Grid.Row="2">
                    <Grid x:Name="ReaderSlot" />
                    <Grid x:Name="SplitChrome" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="SplitSourceColumn" Width="1*" />
                            <ColumnDefinition x:Name="SplitReaderColumn" Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Thumb Grid.Column="1" Width="6" HorizontalAlignment="Left" Margin="-3,0,0,0"
                               Background="{ThemeResource DividerStrokeColorDefaultBrush}" DragDelta="DragSplit" DragCompleted="FinishSplitDrag"
                               AutomationProperties.Name="Resize source and reader" />
                    </Grid>
                    <Grid x:Name="MapSlot" Visibility="Collapsed" />
                    <StackPanel x:Name="Welcome" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                        <TextBlock Text="Open a Markdown file or folder." Style="{StaticResource SubtitleTextBlockStyle}" />
                        <Button x:Name="ResumeButton" Content="Reopen last workspace" Click="ResumeWorkspace" Visibility="Collapsed" />
                        <Button x:Name="SampleButton" Content="Open sample workspace" Click="OpenSample" />
                    </StackPanel>
                    <Border x:Name="PreviewOverlay" Visibility="Collapsed" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" BorderThickness="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                        <Grid RowDefinitions="Auto,*">
                            <CommandBar DefaultLabelPosition="Right">
                                <CommandBar.Content>
                                    <TextBlock x:Name="PreviewTitle" Margin="12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </CommandBar.Content>
                                <AppBarButton x:Name="PreviewBackButton" Label="Back" Icon="Back" Click="PreviewBack" />
                                <AppBarButton x:Name="PreviewOpenButton" Label="Open document" Icon="OpenFile" Click="OpenPreviewDocument" />
                                <AppBarButton Label="Close" Icon="Cancel" Click="ClosePreview" />
                            </CommandBar>
                            <Grid x:Name="PreviewSlot" Grid.Row="1" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
            <Thumb x:Name="AiGrip" Grid.Column="3" Background="{ThemeResource DividerStrokeColorDefaultBrush}" DragDelta="DragAi" DragCompleted="FinishAiDrag" AutomationProperties.Name="Resize assistant" />
            <Grid x:Name="AiSlot" Grid.Column="4" Visibility="Collapsed" />
        </Grid>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="12,3">
            <TextBlock x:Name="Status" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />
            <Grid x:Name="FooterSlot" Grid.Column="1" />
        </Grid>
    </Grid>
</Window>
